<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- OpenUtau's core explicitly exposes its offline internals to this test host. -->
    <AssemblyName>OpenUtau.Test</AssemblyName>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../vendor/OpenUtau/OpenUtau.Core/OpenUtau.Core.csproj" />
  </ItemGroup>
</Project>
